#!/usr/bin/env python3
"""html2pdf <input.html> <output.pdf> [--png-preview DIR]

Renders an HTML file to PDF with WeasyPrint (CSS paged media: @page, page numbers,
page breaks). Relative paths (images, CSS) resolve from the HTML file's folder.
With --png-preview, also writes low-res PNGs of every page so you can look at them.
"""
import subprocess, sys
from pathlib import Path

def main() -> int:
    args = sys.argv[1:]
    if len(args) < 2 or args[0] in ("-h", "--help"):
        print(__doc__); return 2
    src, out = Path(args[0]).resolve(), Path(args[1]).resolve()
    if not src.exists():
        print(f"not found: {src}"); return 1
    import logging
    logging.getLogger("weasyprint").setLevel(logging.ERROR)
    logging.getLogger("fontTools").setLevel(logging.ERROR)
    from weasyprint import HTML
    out.parent.mkdir(parents=True, exist_ok=True)
    doc = HTML(filename=str(src), base_url=str(src.parent)).render()
    doc.write_pdf(str(out))
    print(f"PDF: {out} ({len(doc.pages)} pages, {out.stat().st_size // 1024} KB)")
    if "--png-preview" in args:
        d = Path(args[args.index("--png-preview") + 1]).resolve()
        d.mkdir(parents=True, exist_ok=True)
        subprocess.run(["pdftoppm", "-r", "60", "-png", str(out), str(d / out.stem)], check=False)
        print("Previews:", ", ".join(sorted(p.name for p in d.glob(f"{out.stem}*.png"))))
    return 0

if __name__ == "__main__":
    sys.exit(main())
