# Inside the "web" container: serves the Angular app and forwards API/admin
# requests to Django. HTTPS is handled by the proxy in front (server-setup.sh).
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /django-static/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}
