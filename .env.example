# --- Telegram ---
# Create a bot with @BotFather and paste its token here
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (ask @userinfobot). Only this user is served.
TELEGRAM_OWNER_ID=

# --- Claude (uses your Pro/Max subscription) ---
# On your own computer run:  claude setup-token   and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Do NOT set ANTHROPIC_API_KEY, or usage is billed to the API instead of your plan.

# --- GitHub + deployment (optional, see README "GitHub and deployment") ---
# Your private repo as owner/name, e.g. vladbuzatu/stocfresh
GITHUB_REPO=
# Fine-grained token for that one repo: Contents, Workflows, Actions = Read and write
GITHUB_TOKEN=
# Printed by deploy/server-setup.sh on the app server
STAGING_URL=
PRODUCTION_URL=

# --- Knowledge curator (propose-only; you approve with /learn approve) ---
# Local time for the nightly run (only when the team is idle)
CURATOR_TIME=02:30
# Local time for the evening digest (/today off disables it)
DIGEST_TIME=19:00
# 0 = don't give agents Angular's official AI tooling
ANGULAR_MCP=1

# --- Optional tuning ---
# 1 (default) = skip end-to-end tests between rounds (they still run on GitHub and at the end)
SKIP_E2E=1
# Model alias for the PM and subagents that use "inherit" (e.g. opus, sonnet). Empty = plan default.
CLAUDE_MODEL=
# Build rounds per /build before it stops and waits for you
MAX_BUILD_ROUNDS=20
# Max agent steps inside one round
MAX_TURNS_PER_ROUND=200

# --- CarStage Model Lab (studio agent "model-lab") ---
# Provider keys the lab uses to run CarStage's pipelines. Agents never see them.
# Tip: use separate keys with their own spending limit, not your production keys.
LAB_GEMINI_API_KEY=
LAB_OPENAI_API_KEY=
# Lab budget per testing round, in USD (estimates). A round starts with each message you send.
# Change it for a job with /job budget <usd>, for the PM with /lab budget <usd>.
LAB_BUDGET_USD=5
# Which CarStage pipelines the lab may run, and settings it applies unless an agent sets them.
LAB_PIPELINES=optimal,gemini_compose,openai_compose
LAB_DEFAULT_SETTINGS=openai_compose:OPENAI_IMAGE_EDIT_MODEL=gpt-image-2

# --- Several projects ---
# GitHub access per repo: add each repo to GITHUB_TOKEN, or give a project its own token:
# GITHUB_TOKEN_CARSTAGE=github_pat_...

# --- Voice messages (optional): an OpenAI key for transcription ---
VOICE_OPENAI_API_KEY=
VOICE_LANGUAGE=ro            # ro, en … (empty = detect)
# VOICE_MODEL=gpt-4o-transcribe

# --- Read-only dashboard: ssh -L 8090:localhost:8090 root@SERVER, then http://localhost:8090 ---
DASHBOARD_TOKEN=             # optional extra lock: open /?token=<this> once
# DASHBOARD=0                # turn it off

# --- Agents' internet ---
AGENT_EGRESS=open            # restricted = the build team reaches only an allowlist (studio jobs stay open)
AGENT_EGRESS_ALLOW=          # extra hosts for the allowlist, comma-separated

# --- Capacity ---
PARALLEL_LANES=1             # studio jobs run beside the PM/builds (0 = one queue, for small servers)
MEM_LIMIT=3g                 # memory cap for the agent container

# --- Backups / reports ---
BACKUP_REMOTE=               # rclone remote for off-site backups, e.g. spaces:my-bucket/bbts
SCORECARD_DAY=mon            # weekly scorecard day (sent at DIGEST_TIME)
